# Exemple uniquement : remplacer ces valeurs dans secrets.yaml.
# Si secrets.yaml existe déjà, ajouter seulement les clés manquantes.
wifi_ssid: "MON_WIFI"
wifi_password: "REMPLACER_MOT_DE_PASSE_WIFI"
# Générer une clé avec : openssl rand -base64 32
api_encryption_key: "REMPLACER_PAR_UNE_CLE_BASE64_DE_32_OCTETS"
ota_password: "REMPLACER_MOT_DE_PASSE_OTA"
# Au moins 8 caractères.
fallback_ap_password: "REMPLACER_MOT_DE_PASSE_SECOURS"

# Configuration espgesture.yaml : valeurs propres à cet appareil.
espgesture_api_encryption_key: "REMPLACER_PAR_UNE_CLE_BASE64_DE_32_OCTETS"
espgesture_fallback_ap_password: "REMPLACER_MOT_DE_PASSE_SECOURS"
mqtt_username: "REMPLACER_UTILISATEUR_MQTT"
mqtt_password: "REMPLACER_MOT_DE_PASSE_MQTT"

# Configuration espwaterlevel.yaml.
espwaterlevel_fallback_ap_password: "REMPLACER_MOT_DE_PASSE_SECOURS"

# Configuration espmatrix.yaml.
espmatrix_api_encryption_key: "REMPLACER_PAR_UNE_CLE_BASE64_DE_32_OCTETS"
espmatrix_fallback_ap_password: "REMPLACER_MOT_DE_PASSE_SECOURS"

# Configuration espwebcam.yaml.
espwebcam_fallback_ap_password: "REMPLACER_MOT_DE_PASSE_SECOURS"

# Anciennes versions conservées dans l'historique Git nettoyé.
espwaterlevel_api_encryption_key: "REMPLACER_PAR_L_ANCIENNE_CLE_API_SI_NECESSAIRE"
espwebcam_api_encryption_key: "REMPLACER_PAR_L_ANCIENNE_CLE_API_SI_NECESSAIRE"
